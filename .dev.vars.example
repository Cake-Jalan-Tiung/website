# Copy to .dev.vars for local work. PAYMENTS=fake uses the built-in test payment page; set
# PAYMENTS=chip with the client's CHIP test key and CHIP_BRAND_ID to use CHIP's test mode.
PAYMENTS=fake
CHIP_BRAND_ID=
CHIP_SECRET_KEY=
STAFF_PIN=246810
SESSION_SECRET=generate-with-openssl-rand-hex-32
# StoreHub API token. Sales are sent to StoreHub only when PAYMENTS=chip, so local work never writes there.
STOREHUB_API_TOKEN=
# Where failure alerts are emailed. Empty: alerts only go to the log.
ALERT_TO=
